{include:domain.pdkbddl}
{include:default.pdkbddl}

(define (problem depth_2_agents_2)

    (:domain grapevine)

    (:objects l1 l2 - loc)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init

        ;; (connected l1 l2)
        ;; (connected l2 l1)

        ;; (at alice l1)
        ;; (at bob l2)

        ;; [bel, alice](secret alice)
        [bel, bob](secret bob)


        (forall (?ag - agent)
            [bel, ?ag][des, ?ag](secret ?ag)
        )
    )
    (:goal
        ;; (and (secret alice))
        (and
            (not (connected l1 l2))
            [itn, alice](move alice l1 l2)
            [itn, bob](move alice l1 l2)
        )  
    )
    (:plan )
)