(define (problem depth_3_agents_4)

    (:domain presidents)

    (:objects l1 l2 l3 - loc environment education - policy)

    (:projection )
	(:depth 3)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)
        (connected l2 l3)
        (connected l3 l2)

        (at alice l1)
        (at cindy l2)
        (at derek l3)
        (candidate bob)
        (at bob l2)

        (political-policy bob environment)
        (political-policy bob education)

        (benefit environment alice)
        (benefit education alice)

        (vote bob bob)

    )
    (:goal
        (and
            [bel, derek][dsd, cindy][des, alice](political-policy bob environment)
        )  
    )
    (:plan )
)