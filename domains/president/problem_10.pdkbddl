{include:ancillary_effects.pdkbddl}
{include:ancillary_effects__disdain.pdkbddl}
{include:ancillary_effects__president.pdkbddl}
{include:domain.pdkbddl}

(define (problem depth_2_agents_3)

    (:domain presidents)

    (:objects l1 l2 - loc environment education - policy)

    (:projection )
	(:depth 3)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)
        (connected l2 l3)
        (connected l3 l2)

        (at alice l1)
        (at cindy l2)
        (at derek l3)
        (at evelyn l3)
        (candidate bob)
        (at bob l2)

        (political-policy bob environment)
        (political-policy bob education)

        (benefit environment alice)
        (benefit education alice)
        (!benefit environment cindy)
        (benefit education cindy)
        (benefit environment derek)
        (!benefit education derek)
        (benefit environment evelyn)
        (benefit education evelyn)

        (single-issue-voter cindy education)
        (single-issue-voter derek environment)

        (vote bob bob)

    )
    (:goal
        (and
            [b, derek][dsd, derek][d, alice](political-policy bob education)
            (president bob)
        )  
    )
    (:plan )
)