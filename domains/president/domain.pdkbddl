(define (domain presidents)
	(:agents alice bob cindy derek evelyn)
    (:requirements :typing :universal-preconditions :disjunctive-preconditions)
    (:types loc policy)
    (:predicates
        {AK}(candidate ?ag - agent)
        {AK}(at ?ag - agent ?l - loc)
        {AK}(connected ?l1 ?l2 - loc)
        {AK}(benefit ?p - policy ?ag - agent)
        {AK}(president ?ag - agent)
        {AK}(single-issue-voter ?ag - agent ?p - policy)
        (listen ?a1 ?a2 - agent)
        (political-policy ?ag - agent ?p - policy)
        (placed-vote ?a1 ?a2 - agent)
    )

    (:action move
        :derive-condition   always
        :parameters         (?a - agent ?l1 ?l2 - loc)
        :precondition       (and (at ?a ?l1) (connected ?l1 ?l2))
        :effect             (and (at ?a ?l2) (not (at ?a ?l1)))
    )

    (:action adopt-disdain-for-policy
        :derive-condition   (at $agent$ ?l)
        :parameters         (?ag ?cd - agent ?p - policy ?l - loc)
        :precondition       (and (not (benefit ?p ?ag)) (candidate ?cd) (at ?ag ?l))
        :effect             (and [dsd, ?ag](political-policy ?cd ?p))
    )

    (:action adopt-desire-for-policy
        :derive-condition   (at $agent$ ?l)
        :parameters         (?ag ?cd - agent ?p - policy ?l - loc)
        :precondition       (and (benefit ?p ?ag) (candidate ?cd) (at ?ag ?l))
        :effect             (and [des, ?ag](political-policy ?cd ?p))
    )

    (:action speak-for-policy
        :derive-condition   (at $agent$ ?l)
        :parameters         (?a1 ?a2 ?cd - agent ?p - policy ?l - loc)
        :precondition       (and (at ?a1 ?l) (at ?a2 ?l) [des, ?a1][des, ?a2](political-policy ?cd ?p) (candidate ?cd))
        :effect             (and
                                (when [des, ?a2](listen ?a2 ?a1) [des, ?a2](political-policy ?cd ?p))
                                (when !<des, ?a2>(listen ?a2 ?a1) [des, ?a2](!political-policy ?cd ?p))
                            )
    )

    (:action speak-against-policy
        :derive-condition   (at $agent$ ?l)
        :parameters         (?a1 ?a2 ?cd - agent ?p - policy ?l - loc)
        :precondition       (and (at ?a1 ?l) (at ?a2 ?l) [des, ?a1][dsd, ?a2](political-policy ?cd ?p) (candidate ?cd))
        :effect             (and
                                (when [des, ?a2](listen ?a2 ?a1) [dsd, ?a2](political-policy ?cd ?p))
                                (when !<des, ?a2>(listen ?a2 ?a1) [dsd, ?a2](!political-policy ?cd ?p))
                            )
    )

    (:action become-political-opponent
        :derive-condition   never
        :parameters         (?a1 ?a2 ?cd - agent ?p - policy)
        :precondition       (and (candidate ?cd) [dsd, ?a1][des, ?a2](political-policy ?cd ?p))
        :effect             (and !<des, ?a1>(listen ?a1 ?a2))
    )

    (:action decide-vote
        :derive-condition   never
        :parameters         (?ag ?cd - agent)
        :precondition       (and (candidate ?cd) (forall (?p - policy) [des, ?ag](political-policy ?cd ?p)))
        :effect             (and [itn, ?ag](vote ?ag ?cd) 
                                (forall (?a2 - agent) (when (not (candidate ?a2)) [des, ?ag][itn, ?a2](vote ?a2 ?cd)))
                            )
    )

    (:action vote
        :derive-condition   never
        :parameters         (?ag ?cd - agent)
        :precondition       (and (candidate ?cd) [itn, ?ag](vote ?ag ?cd))
        :effect             (and (placed-vote ?ag ?cd))
    )

    (:action decide-vote-single-issue
        :derive-condition   never
        :parameters         (?ag ?cd - agent ?p - policy)
        :precondition       (and (candidate ?cd) (single-issue-voter ?ag ?p) [des, ?ag](political-policy ?cd ?p))
        :effect             (and [itn, ?ag](vote ?ag ?cd)
                                (forall (?a2 - agent) (when (not (candidate ?a2)) [des, ?ag][itn, ?a2](vote ?a2 ?cd)))
                            )
    )

    (:action get-elected
        :derive-condition never
        :parameters         (?cd - agent)
        :precondition       (and (candidate ?cd) (forall (?ag - agent) (placed-vote ?ag ?cd)))
        :effect             (and (president ?cd))
    )
)