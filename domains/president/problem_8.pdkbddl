{include:domain.pdkbddl}
{include:ae_default.pdkbddl}
{include:ae_desire.pdkbddl}
{include:ae_intention.pdkbddl}
{include:ae_disdain.pdkbddl}
{include:ancillary_effects__president.pdkbddl}

(define (problem depth_2_agents_3)

    (:domain presidents)

    (:objects l1 l2 - loc environment education - policy)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)

        (at alice l1)
        (at cindy l2)
        (candidate bob)
        (at bob l2)

        (political-policy bob environment)
        (political-policy bob education)

        (benefit environment alice)
        (benefit education alice)

        [des, cindy](listen cindy alice)

        (placed-vote bob bob)

    )
    (:goal
        (and
            [des, cindy](political-policy bob environment)
            [des, cindy](political-policy bob education)
        )  
    )
    (:plan )
)