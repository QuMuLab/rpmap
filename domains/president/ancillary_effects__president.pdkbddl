(:ancillary_effects
    (:anceff spread-disdain
        :parameters (?a1 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [dsd, ?a1]{rml}
            :type add
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {[des, ?a1][dsd, ?ag]{rml} for ?ag in ?agents}
            :type add
        )
    )

    (:anceff spread-desire
        :parameters (?a1 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [des, ?a1]{rml}
            :type add
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {[des, ?a1][des, ?ag]{rml} for ?ag in ?agents}
            :type add
        )
    )

    (:anceff disdain-desire
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1][des, ?a2]{rml}
            :type add
        )
        :consequent (
            :poscond ?pos + [dsd, ?a1]{rml}
            :negcond ?neg
            :rml [dsd, ?a1][des, ?a2]{rml}
            :type add
        )
    )
)