
(define (domain romance)

	(:agents alice bob cindy derek evelyn)
    (:requirements :typing)
    (:types loc agent gift)
    (:constants )

    (:predicates
        {AK}(connected ?l1 ?l2 - loc)
        {AK}(at ?ag - agent ?l - loc)
        {AK}(gift-at ?g - gift ?l - loc)
        {AK}(together ?a1 ?a2 - agent)
        {AK}(bought-gift ?ag - agent ?g - gift)
        {AK}(feel-chemistry ?a1 ?a2 - agent)
        (get-gift-for ?ag - agent)
        (likes-gift ?ag - agent ?g - gift)
        (agent ?ag - agent)
        (sad ?ag - agent)
    )

    (:action move
        :derive-condition   never
        :parameters         (?a - agent ?l1 ?l2 - loc)
        :precondition       (and (at ?a ?l1) (connected ?l1 ?l2))
        :effect             (and (at ?a ?l2) (not (at ?a ?l1)))
    )

    (:action fall-in-love
        :derive-condition   (at $agent$ ?l)
        :parameters         (?a1 ?a2 - agent ?l - loc)
        :precondition       (and (at ?a1 ?l) (at ?a2 ?l) (feel-chemistry ?a1 ?a2))
        :effect             (and
                                [lov, ?a1](agent ?a2)
                            )
    )

    (:action confess
        :derive-condition   (at $agent$ ?l)
        :parameters         (?a1 ?a2 - agent ?l - loc)
        :precondition       (and (at ?a1 ?l) (at ?a2 ?l) [lov, ?a1](agent ?a2) <bel, ?a1>[lov, ?a2](agent ?a1))
        :effect             (and
                                (when [lov, ?a2](agent ?a1) (and (together ?a1 ?a2) [bel, ?a1][lov, ?a2](agent ?a1)))
                                (when (not [lov, ?a2](agent ?a1)) (and (sad ?a1) [bel, ?a1]![lov, ?a2](agent ?a1)))
                            )
    )

    (:action intend-get-gift
        :derive-condition   never
        :parameters         (?a1 ?a2 - agent ?g - gift ?l - loc)
        :precondition       (and [lov, ?a1](agent ?a2) [des, ?a1][lov, ?a2](agent ?a1) [bel, ?a1](likes-gift ?a2 ?g) (gift-at ?g ?l))
        :effect             (and
                                [itn, ?a1](retrieve-gift ?a1 ?a2 ?g ?l)
                            )
    )

    (:action retrieve-gift
        :derive-condition   never
        :parameters         (?a1 ?a2 - agent ?g - gift ?l - loc)
        :precondition       (and [itn, ?a1](retrieve-gift ?a1 ?a2 ?g ?l) (at ?a1 ?l) (gift-at ?g ?l))
        :effect             (and
                                (not (gift-at ?g ?l))
                                (bought-gift ?a1 ?g)
                            )
    )

    (:action gift
        :derive-condition   never
        :parameters         (?a1 ?a2 - agent ?g - gift ?l - loc)
        :precondition       (and (bought-gift ?a1 ?g) [des, ?a1][lov, ?a2](agent ?a1) (at ?a1 ?l) (at ?a2 ?l))
        :effect             (and
                                (when (likes-gift ?a2 ?g) (and [lov, ?a2](agent ?a1) [bel, ?a2][lov, ?a2](agent ?a1)))
                                (when (not (likes-gift ?a2 ?g)) (and (not [lov, ?a2](agent ?a1)) [bel, ?a2]![lov, ?a2](agent ?a1)))
                            )

    )

)
