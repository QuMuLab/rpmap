
(define (domain romance)

	(:agents alice bob cindy)
    (:requirements :typing)
    (:types loc agent)
    (:constants )

    (:predicates
        {AK}(connected ?l1 ?l2 - loc)
        {AK}(at ?ag - agent ?l - loc)
        {AK}(chemistry ?a1 ?a2 - agent)
        (date ?a1 ?a2 - agent)
        (friend ?a1 ?a2 - agent)
    )

    (:action move
        :derive-condition   never
        :parameters         (?a - agent ?l1 ?l2 - loc)
        :precondition       (and (at ?a ?l1) (connected ?l1 ?l2))
        :effect             (and (at ?a ?l2) (not (at ?a ?l1)))
    )

    (:action go-on-date
        :derive-condition   (at $agent$ ?l)
        :parameters         (?a1 ?a2 - agent ?l - loc)
        :precondition       (and (at ?a1 ?l) (at ?a2 ?l) [i, ?a1](go-on-date ?a1 ?a2 ?l))
        :effect             (and 
                                (when (chemistry ?a1 ?a2) [d, ?a1](date ?a1 ?a2))
                                (when (chemistry ?a1 ?a2) [d, ?a2](date ?a2 ?a1))
                                (when (!chemistry ?a1 ?a2) [dsd, ?a1](date ?a1 ?a2))
                                (when (!chemistry ?a1 ?a2) [dsd, ?a2](date ?a2 ?a1))
                            )
    )

    (:action friend-set-up
        :derive-condition   never
        :parameters         (?a1 ?a2 ?a3 - agent ?l - loc)
        :precondition       (and (friend ?a1 ?a2) (friend ?a1 ?a3))
        :effect             (and 
                                [d, ?a1][d, ?a2](date ?a2 ?a3)
                                [d, ?a1][d, ?a3](date ?a3 ?a2)
                                [i, ?a2](go-on-date ?a2 ?a3 ?l)
                            )
    )

)
