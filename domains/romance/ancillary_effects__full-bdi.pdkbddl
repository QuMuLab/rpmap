(:ancillary_effects
    (:anceff set-love-desire
            :parameters (?a1 ?a2 - agent)
            :antecedent (
                :poscond ?pos
                :negcond ?neg
                :rml [lov, ?a1](agent ?a2)
                :type add
            )
            :consequent (
                :poscond ?pos
                :negcond ?neg
                :rml [des, ?a1][lov, ?a2](agent ?a1)
                :type add
            )
    )
    (:anceff become-rival
        :parameters (?a1 ?a2 ?a3 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1][lov, ?a2](agent ?a3)
            :type add
        )
        :consequent (
            :poscond ?pos + [lov, ?a1](agent ?a3) + (not (together ?a1 ?a3)) + (not (together ?a2 ?a3))
            :negcond ?neg
            :rml [dsd, ?a1](agent ?a2)
            :type add
        )
    )
)

