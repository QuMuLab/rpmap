{include:ancillary_effects__love.pdkbddl}
{include:ancillary_effects__romance.pdkbddl}
{include:domain.pdkbddl}

(define (problem depth_2_agents_3)

    (:domain romance)

    (:objects l1 l2 - loc)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)

        (at alice l1)
        (at bob l2)
        (at cindy l2)

        (friend alice cindy)
        (friend alice bob)

        (!chemistry cindy bob)

    )
    (:goal
        (and
            [dsd, bob](date bob cindy)
        )  
    )
    (:plan )
)