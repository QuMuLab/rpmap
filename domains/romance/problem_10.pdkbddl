{include:ancillary_effects__full-bdi.pdkbddl}


(define (problem paper2)

    (:domain romance)

    (:objects l1 l2 l3 - loc chocolate teddy_bear - gift)

    (:projection )
    (:depth 3)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)
        (connected l2 l3)
        (connected l3 l2)

        (at alice l1)
        (at bob l2)
        (at cindy l2)
        (at derek l3)
        (at evelyn l3)
        (feel-chemistry cindy alice)
        (feel-chemistry alice bob)
        (feel-chemistry derek alice)
        (feel-chemistry evelyn derek)
        (gift-at chocolate l3)
        (gift-at teddy_bear l1)
        [bel, cindy](likes-gift alice teddy_bear)
        [bel, alice](likes-gift bob chocolate)
        [bel, evelyn](likes-gift derek chocolate)
        (likes-gift alice teddy_bear)
        (likes-gift derek chocolate)
    )

    (:goal 
        (and
            [bel, alice](!loves bob alice)
            [lov, alice](agent cindy)
            [lov, derek](agent alice)
            [lov, evelyn](agent derek)
            [bel, alice][bel, cindy][lov, derek](agent alice)
            (together evelyn derek)
        )
    )

    (:plan
    
    )
)