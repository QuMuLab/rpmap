{include:domain.pdkbddl}
{include:ae_default.pdkbddl}

(define (problem depth_2_agents_3)

    (:domain grapevine)

    (:objects l1 l2 l3 - loc)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init

        (connected l1 l2)
        (connected l2 l1)
        (connected l2 l3)
        (connected l3 l2)

        (at alice l1)
        (at bob l2)
        (at cindy l3)

        [bel, alice](secret alice)
        ![bel, cindy](secret alice)
    )
    (:goal
        (and
            [bel, cindy](secret alice)
            <bel, cindy>(secret alice)
        )  
    )
    (:plan )
)