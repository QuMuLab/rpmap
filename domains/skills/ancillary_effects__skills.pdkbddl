(:ancillary_effects
    (:anceff spread-love
        :parameters (?a1 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [l, ?a1](rml)
            :type add
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {[d, ?a1][l, ?ag](rml) for ?ag in agents}
            :type add
        )
    )
    (:anceff love-desire
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][d, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos + [d, ?a1][l, ?a2](rml)
            :negcond ?neg
            :rml [l, ?a1][d, ?a2](rml)
            :type add
        )
    )
    (:anceff love-belief
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][b, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos + [d, ?a1][l, ?a1](rml)
            :negcond ?neg
            :rml [l, ?a1][b, ?a2](rml)
            :type add
        )
    )
