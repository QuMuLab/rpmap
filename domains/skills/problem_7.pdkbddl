(define (problem depth_2_agents_3)

    (:domain skills)

    (:objects l1 l2 l3 - loc guitar - skill)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)
        (connected l2 l3)
        (connected l3 l2)

        (at alice l1)
        (at bob l3)
        (at cindy l2)

        (expert cindy guitar)

        [des, bob](learn-skill bob guitar)
        [bel, bob](interesting guitar)
        (beginner bob guitar)
        (natural bob guitar)

        (beginner alice guitar)
        (natural alice guitar)
    )
    (:goal
        (and
            [bel, bob][bel, alice](interesting guitar)
            [bel, cindy][bel, alice](interesting guitar)
        )  
    )
    (:plan )
)