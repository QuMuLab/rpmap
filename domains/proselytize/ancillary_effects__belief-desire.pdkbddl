(:ancillary_effects
    (:anceff follower-adopt-belief
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1][bel, ?a2]{rml}
            :type add
        )
        :consequent (
            :poscond ?pos + (follower ?a1 ?a2)
            :negcond ?neg
            :rml [bel, ?a1]{rml} + {[des, ?a1][bel, ?ag]{rml} for ?ag in ?agents}
            :type add
        )
    )
    (:anceff skeptic-stop-beliefs
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1][bel, ?a2]{rml}
            :type add
        )
        :consequent (
            :poscond ?pos + (skeptical ?a1 ?a2)
            :negcond ?neg
            :rml {[des, ?a1][bel, ?ag]!{rml} for ?ag in ?agents}
            :type add
        )
    )
)

