(define (problem paper2)

    (:domain pirates)

    (:objects ship island base - loc jewelry coins - treasure)

    (:projection )
    (:depth 3)
    (:task valid_generation)

    (:init-type complete)
    (:init

        (connected ship island)
        (connected island base)
        (enemy-base base)
        (at alice ship)
        (at bob ship)
        (at cindy island)
        (at derek island)
        (at evelyn island)
        (pirate alice)
        (pirate bob)
        (enemy cindy)
        (enemy derek)
        (enemy evelyn)
        (treasure-at jewelry island)
        (has-parrot alice)

        !<itn, alice>(fight alice alice island)
        !<itn, alice>(fight alice bob island)
        !<itn, bob>(fight bob bob island)
        !<itn, bob>(fight bob alice island)

        [des, alice](got-treasure alice jewelry)
        [des, bob](got-treasure bob jewelry)
        (stronger alice cindy)
        (stronger alice derek)
        (stronger alice evelyn)
        (stronger cindy bob)
        (stronger derek bob)
        (stronger evelyn bob)
    )

    (:goal 
        (and
            (defeated cindy)
            (defeated derek)
            (defeated evelyn)
            (defeated bob)
            (got-treasure alice jewelry)
        )
    )

    (:plan
    
    )
)