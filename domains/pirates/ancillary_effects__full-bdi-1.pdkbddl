(:ancillary_effects
    (:anceff travel-for-treasure
        :parameters (?a - agent ?t - treasure ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a](treasure-at ?t ?l) 
            :type add
        )
        :consequent (
            :poscond ?pos + [des, ?a](got-treasure ?a ?t) + (at ?a $loc$) + (connected $loc$ ?l)
            :negcond ?neg
            :rml [itn, ?a](move ?a $loc$ ?l)
            :type add
        )
    )
    (:anceff begin-search
        :parameters (?a - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + [bel, ?a](treasure-at $t$ ?l)
            :negcond ?neg
            :rml [itn, ?a](search-for-treasure ?a $t$ ?l)
            :type add
        )
    )
    (:anceff encounter-enemies
        :parameters (?a - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (at $enemy$ ?l) + (enemy $enemy$)
            :negcond ?neg
            :rml [itn, ?a](fight ?a $enemy$ ?l)
            :type add
        )
    )
    (:anceff enemy-flee
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1](defeated ?a2)
            :type add
        )
        :consequent (
            :poscond ?pos + (enemy ?a1) + (enemy ?a2) + (at ?a1 $l1$) + (connected $l1$ $l2$) + (enemy-base $l2$)
            :negcond ?neg
            :rml [itn, ?a1](move ?a1 $l1$ $l2$)
            :type add
        )
    )
)

