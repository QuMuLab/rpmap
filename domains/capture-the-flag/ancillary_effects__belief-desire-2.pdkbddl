(:ancillary_effects
    (:anceff catch
        :parameters (?a1 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (capturer ?a1) + (defender $agent$) + (at $agent$ ?l) + (not (hiding-at ?a1 ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught ?a1)
            :type add
        )
    )
    (:anceff catch_2
        :parameters (?a1 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (capturer $agent$) + (defender ?a1) + (at $agent$ ?l) + (not (hiding-at $agent$ ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught $agent$)
            :type add
        )
    )
    (:anceff catch-scout
        :parameters (?a1 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout ?a1) + (defender $agent$) + (at $agent$ ?l) + (not (hiding-at ?a1 ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught ?a1)
            :type add
        )
    )
    (:anceff catch-scout_2
        :parameters (?a1 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout $agent$) + (defender ?a1) + (at $agent$ ?l) + (not (hiding-at $agent$ ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught $agent$)
            :type add
        )
    )
    (:anceff catch-hiding
        :parameters (?a1 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (capturer $agent$) + (defender ?a1) + (at $agent$ ?l) + (hiding-at $agent$ ?l) + [bel, ?a1](hiding-spot-at ?l) + (not (capture-win))
            :negcond ?neg
            :rml (caught $agent$)
            :type add
        )
    )
    (:anceff scout-share-flag-info
        :parameters (?a1 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1](flag-at ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout ?a1) + (capturer $agent$)
            :negcond ?neg
            :rml [des, ?a1][bel, $agent$](flag-at ?l)
            :type add
        )
    )
    (:anceff scout-share-hiding-spot-info
        :parameters (?a1 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1](hiding-spot-at ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout ?a1) + (capturer $agent$)
            :negcond ?neg
            :rml [des, ?a1][bel, $agent$](hiding-spot-at ?l)
            :type add
        )
    )
)

