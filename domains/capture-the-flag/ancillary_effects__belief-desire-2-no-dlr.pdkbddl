(:ancillary_effects
    (:anceff catch
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (capturer ?a1) + (defender ?a2) + (at ?a2 ?l) + (not (hiding-at ?a1 ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught ?a1)
            :type add
        )
    )
    (:anceff catch_2
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (capturer ?a2) + (defender ?a1) + (at ?a2 ?l) + (not (hiding-at ?a2 ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught ?a2)
            :type add
        )
    )
    (:anceff catch-scout
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout ?a1) + (defender ?a2) + (at ?a2 ?l) + (not (hiding-at ?a1 ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught ?a1)
            :type add
        )
    )
    (:anceff catch-scout_2
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout ?a2) + (defender ?a1) + (at ?a2 ?l) + (not (hiding-at ?a2 ?l)) + (not (capture-win))
            :negcond ?neg
            :rml (caught ?a2)
            :type add
        )
    )
    (:anceff catch-hiding
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml (at ?a1 ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (capturer ?a2) + (defender ?a1) + (at ?a2 ?l) + (hiding-at ?a2 ?l) + [bel, ?a1](hiding-spot-at ?l) + (not (capture-win))
            :negcond ?neg
            :rml (caught ?a2)
            :type add
        )
    )
    (:anceff scout-share-flag-info
        :parameters (?test ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?test](flag-at ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout ?test) + (capturer ?a2)
            :negcond ?neg
            :rml [des, ?test][bel, ?a2](flag-at ?l)
            :type add
        )
    )
    (:anceff scout-share-hiding-spot-info
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [bel, ?a1](hiding-spot-at ?l)
            :type add
        )
        :consequent (
            :poscond ?pos + (scout ?a1) + (capturer ?a2)
            :negcond ?neg
            :rml [des, ?a1][bel, ?a2](hiding-spot-at ?l)
            :type add
        )
    )
)

