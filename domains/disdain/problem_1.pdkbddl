{include:ancillary_effects.pdkbddl}
{include:ancillary_effects__disdain.pdkbddl}
{include:ancillary_effects__presidents.pdkbddl}
{include:domain.pdkbddl}

(define (problem depth_2_agents_2)

    (:domain presidents)

    (:objects l1 l2 - loc environment - policy)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)

        (at alice l1)
        (candidate bob)
        (at bob l2)

        (political-policy bob environment)
        (benefit environment bob)

        [d, alice](listen alice bob)        
    )
    (:goal
        (and
            [d, alice](political-policy bob environment)
        )  
    )
    (:plan )
)