{include:ancillary_effects.pdkbddl}
{include:ancillary_effects__disdain.pdkbddl}
{include:domain.pdkbddl}

(define (problem depth_2_agents_2)

    (:domain grapevine)

    (:objects l1 l2 - loc)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init

        (connected l1 l2)
        (connected l2 l1)

        (at alice l1)
        (at bob l2)

        (disdain alice bob)
    )
    (:goal
        (and
            [dsd, alice](secret bob)
        )  
    )
    (:plan )
)