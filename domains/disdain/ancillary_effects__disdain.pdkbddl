(:ancillary_effects
    (:anceff kd45closure__disdain
        :parameters (?a - agent)
        :antecedent 
        (
            :poscond ?pos
            :negcond ?neg
            :rml [dsd, ?a](rml)
            :type wildcard
        )
        :consequent 
        (
            :poscond ?pos
            :negcond ?neg
            :rml <dsd, ?a>(rml)
            :type add
        )
    )
    (:anceff kd45-un-closure__disdain
        :parameters (?a - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml <dsd, ?a>(rml)
            :type wildcard
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml [dsd, ?a](rml)
            :type del
        )
    )
)

