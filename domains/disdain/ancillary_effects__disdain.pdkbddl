(:ancillary_effects
    (:anceff disdain-desire
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][d, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos + (disdain ?a1 ?a2)
            :negcond ?neg
            :rml [dsd, ?a1](rml)
            :type add
        )
    )
)

