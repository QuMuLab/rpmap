{include:ancillary_effects.pdkbddl}
{include:ancillary_effects__disdain.pdkbddl}
{include:ancillary_effects__presidents.pdkbddl}
{include:domain.pdkbddl}

(define (problem depth_2_agents_3)

    (:domain presidents)

    (:objects l1 l2 - loc environment education - policy)

    (:projection )
	(:depth 2)
    (:task valid_generation)

    (:init-type complete)
    (:init
        (connected l1 l2)
        (connected l2 l1)

        (at alice l1)
        (at cindy l2)
        (candidate bob)
        (at bob l2)

        (political-policy bob environment)
        (political-policy bob education)

        (benefit environment alice)
        (benefit environment cindy)
        (!benefit education alice)
        (benefit education cindy)

        !<d, cindy>(listen cindy alice)

        (vote bob bob)

    )
    (:goal
        (and
            [dsd, cindy](!political-policy bob education)
        )  
    )
    (:plan )
)