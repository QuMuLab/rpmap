(:ancillary_effects
    (:anceff kd45closure__love
        :parameters (?a - agent)
        :antecedent 
        (
            :poscond ?pos
            :negcond ?neg
            :rml [l, ?a](rml)
            :type wildcard
        )
        :consequent 
        (
            :poscond ?pos
            :negcond ?neg
            :rml <l, ?a>(rml)
            :type add
        )
    )
    (:anceff kd45-un-closure__love
        :parameters (?a - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml <l, ?a>(rml)
            :type wildcard
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml [l, ?a](rml)
            :type del
        )
    )
    (:anceff spread-love
        :parameters (?a1 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [l, ?a1](rml)
            :type wildcard
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {[d, ?a1][l, ?ag](rml) for ?ag in agents}
            :type add
        )
    )
    (:anceff love-desire
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][d, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos + [l, ?a1](rml)
            :negcond ?neg
            :rml [l, ?a1][d, ?a2](rml)
            :type add
        )
    )
    (:anceff love-belief
        :parameters (?a1 ?a2 - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][b, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos + [l, ?a1](rml)
            :negcond ?neg
            :rml [l, ?a1][b, ?a2](rml)
            :type add
        )
    )
    (:anceff believe-possible-love
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][d, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1]<l, ?a2>(rml)
            :type add
        )
    )
    (:anceff believe-disdain-not-love
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][dsd, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml !<b, ?a1>[l, ?a2](rml)
            :type add
        )
    )
    (:anceff disdain-love
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][l, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos + [dsd, ?a1](rml)
            :negcond ?neg
            :rml [dsd, ?a1][l, ?a2](rml)
            :type add
        )
    )
    (:anceff love-disdain
        :parameters (?a1 ?a2 - agent ?l - loc)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml [b, ?a1][dsd, ?a2](rml)
            :type add
        )
        :consequent (
            :poscond ?pos + [dsd, ?a1](rml)
            :negcond ?neg
            :rml [l, ?a1][dsd, ?a2](rml)
            :type add
        )
    )
)

