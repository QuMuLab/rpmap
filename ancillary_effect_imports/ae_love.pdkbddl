(:ancillary_effects
    (:anceff kd45closure__love
        :parameters (?a - agent)
        :antecedent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a intends (rml)
            :rml {nesting}[lov, ?a]{nesting}{rml}
            :type add
        )
        :consequent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a possibly intends (rml)
            :rml {nesting}<lov, ?a>{nesting}{rml}
            :type add
        )
    )
    (:anceff kd45-un-closure__love
        :parameters (?a - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}<lov, ?a>{nesting}{rml}
            :type del
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}[lov, ?a]{nesting}{rml}
            :type del
        )
    )
)
