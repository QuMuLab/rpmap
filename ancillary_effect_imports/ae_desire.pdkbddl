(:ancillary_effects
    (:anceff kd45closure__desire
        :parameters (?a - agent)
        :antecedent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a desires (rml)
            :rml {nesting}[des, ?a]{nesting}{rml}
            :type add
        )
        :consequent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a possibly desires (rml)
            :rml {nesting}<des, ?a>{nesting}{rml}
            :type add
        )
    )
    (:anceff kd45-un-closure__desire
        :parameters (?a - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}<des, ?a>{nesting}{rml}
            :type del
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}[des, ?a]{nesting}{rml}
            :type del
        )
    )
)
