(:ancillary_effects
    ; NON-BDI ANCILLARY EFFECTS
    (:anceff negation-removal
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml {rml}
            :type add
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml !{rml}
            :type del
        )
    )
    (:anceff uncertain-firing
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml {rml}
            :type add
        )
        :consequent (
            :negcond {!{r} for {r} in ?pos} + ?neg
            :rml !{rml}
            :type del
        )
    )

    ;; ; KD45 CLOSURE
    (:anceff kd45closure__belief
        :parameters (?a - agent)
        :antecedent 
        (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}[bel, ?a]{nesting}{rml}
            :type add
        )
        :consequent 
        (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}<bel, ?a>{nesting}{rml}
            :type add
        )
    )
    (:anceff kd45closure__desire
        :parameters (?a - agent)
        :antecedent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a desires (rml)
            :rml {nesting}[des, ?a]{nesting}{rml}
            :type add
        )
        :consequent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a possibly desires (rml)
            :rml {nesting}<des, ?a>{nesting}{rml}
            :type add
        )
    )
    (:anceff kd45closure__intention
        :parameters (?a - agent)
        :antecedent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a intends (rml)
            :rml {nesting}[itn, ?a]{nesting}{rml}
            :type add
        )
        :consequent 
        (
            :poscond ?pos
            :negcond ?neg
            ; agent a possibly intends (rml)
            :rml {nesting}<itn, ?a>{nesting}{rml}
            :type add
        )
    )

    ;; ; KD45 UNCLOSURE
    (:anceff kd45-un-closure__belief
        :parameters (?a - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}<bel, ?a>{nesting}{rml}
            :type del
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}[bel, ?a]{nesting}{rml}
            :type del
        )
    )
    (:anceff kd45-un-closure__desire
        :parameters (?a - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}<des, ?a>{nesting}{rml}
            :type del
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}[des, ?a]{nesting}{rml}
            :type del
        )
    )
    (:anceff kd45-un-closure__intention
        :parameters (?a - agent)
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}<itn, ?a>{nesting}{rml}
            :type del
        )
        :consequent (
            :poscond ?pos
            :negcond ?neg
            :rml {nesting}[itn, ?a]{nesting}{rml}
            :type del
        )
    )

    ;; ; MUTUAL AWARENESS (BELIEF ONLY)
    (:anceff mutual-awareness-pos__belief
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :need_awareness true
            :rml {rml}
            :type add
        )
        :consequent (
            :poscond {[bel, ?ag]{r} for {r} in ?pos for ?ag in ?agents} + {![bel, ?ag]{r} for {r} in ?neg for ?ag in ?agents}
            :rml [bel, ?ag]{rml}
            :type add
        )
    )
    (:anceff mutual-awareness-neg__belief
        :antecedent (
            :poscond ?pos
            :negcond ?neg
            :need_awareness true
            :rml {rml}
            :type del
        )
        :consequent (
            :poscond {[bel, ?ag]{r} for {r} in ?pos for ?ag in ?agents} + {![bel, ?ag]{r} for {r} in ?neg for ?ag in ?agents}
            :rml ![bel, ?ag]{rml}
            :type add
        )
    )
)
